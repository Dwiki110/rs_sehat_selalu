# RS Sehat Selalu - .gitignore

# Sensitive Configuration Files
config.php
koneksi.php
.env
.env.local
.env.production

# Security Keys and Certificates
*.key
*.pem
*.crt
*.p12
keys/
certs/

# Log Files
logs/
*.log
error.log
access.log
security.log

# Cache and Temporary Files
cache/
tmp/
temp/
*.tmp
*.cache

# Database Files
*.sql.gz
*.db
*.sqlite
*.sqlite3
backup_*.sql
dump_*.sql

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Composer Dependencies
vendor/
composer.lock

# Node.js Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Build Output
dist/
build/
public/build/

# Media Uploads
uploads/
media/
assets/uploads/
*.jpg
*.jpeg
*.png
*.gif
*.pdf
*.doc
*.docx

# Session Files
sessions/
*.sess

# Backup Files
*.bak
*.backup
*.old
backup/
backups/

# System Files
.htaccess
.htpasswd
robots.txt
sitemap.xml

# Testing
tests/coverage/
coverage/
phpunit.xml
.phpunit.result.cache

# Development Tools
.sass-cache/
*.map
*.min.js
*.min.css

# Runtime Files
*.pid
*.sock

# Windows
*.exe
*.msi
*.lnk

# macOS
.AppleDouble
.LSOverride
Icon?
._*

# Linux
*~
.fuse_hidden*
.Trash-*
.nfs*

# Deployment
deploy.sh
deployment/
scripts/deploy/

# Local Development
local_config.php
dev_config.php
debug.php

# Documentation Build
docs/_build/
docs/.doctrees/

# Ignore upgrade script after use (security)
run_security_upgrade.php
run_upgrade_cli.php

# Custom
custom_config/
local_settings/
private/
